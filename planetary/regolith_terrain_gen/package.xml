<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>regolith_terrain_gen</name>
  <version>0.1.0</version>
  <description>Procedural lunar terrain generator: heightmaps, crater fields, rock scatter, and Gazebo world files</description>
  <maintainer email="info@astro42.com">Regolith Project contributors</maintainer>
  <license>Apache-2.0</license>

  <depend>python3-numpy</depend>
  <depend>python3-pil</depend>
  <depend>python3-scipy</depend>
  <depend>python3-yaml</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
