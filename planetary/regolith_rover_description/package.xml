<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>regolith_rover_description</name>
  <version>0.1.0</version>
  <description>URDF/Xacro of the Regolith hello-world rover: 4-wheel skid-steer chassis, IMU, forward camera</description>
  <maintainer email="info@astro42.com">Regolith Project contributors</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
